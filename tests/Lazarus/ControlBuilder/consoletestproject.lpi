<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <PathDelim Value="\"/>
    <General>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="consoletestproject"/>
      <ResourceType Value="res"/>
      <UseXPManifest Value="True"/>
      <Icon Value="0"/>
    </General>
    <BuildModes>
      <Item Name="Default" Default="True"/>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <RequiredPackages>
      <Item>
        <PackageName Value="fpcunittestrunner"/>
      </Item>
      <Item>
        <PackageName Value="LCL"/>
      </Item>
      <Item>
        <PackageName Value="FCL"/>
      </Item>
    </RequiredPackages>
    <Units>
      <Unit>
        <Filename Value="consoletestproject.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="ucontrolcreatortests.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="UControlCreatorTests"/>
      </Unit>
      <Unit>
        <Filename Value="ucontrolbuildertests.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="UControlBuilderTests"/>
      </Unit>
      <Unit>
        <Filename Value="uobjectbuildertests.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="UObjectBuilderTests"/>
      </Unit>
      <Unit>
        <Filename Value="ucomponentbuildertests.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="UComponentBuilderTests"/>
      </Unit>
      <Unit>
        <Filename Value="ucomponentregistrytest.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="UComponentRegistryTest"/>
      </Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <PathDelim Value="\"/>
    <Target>
      <Filename Value="consoletestproject"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="$(ProjOutDir)"/>
      <OtherUnitFiles Value="..\..\..\src"/>
      <UnitOutputDirectory Value="lib\console-$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
    <Linking>
      <Debugging>
        <DebugInfoType Value="dsDwarf3"/>
      </Debugging>
      <Options>
        <Win32>
          <GraphicApplication Value="False"/>
        </Win32>
      </Options>
    </Linking>
  </CompilerOptions>
</CONFIG>
